# Copie este arquivo para .env e preencha com suas chaves reais.
# O arquivo .env já está no .gitignore — nunca será commitado.
#
# Chave genérica (funciona com qualquer provedor como fallback):
CONTRACTFOL_API_KEY=sk-...

# Chaves específicas por provedor (sobrepõem a chave genérica):
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# DASHSCOPE_API_KEY=sk-...
# MOONSHOT_API_KEY=sk-...
# GOOGLE_API_KEY=...

# Overrides opcionais de execução:
# CONTRACTFOL_LLM=deepseek          # sobrepõe "models:" do experiment.yaml
# CONTRACTFOL_MODEL=deepseek-chat   # sobrepõe model_id do registry
# CONTRACTFOL_TEMPERATURE=0.2
# CONTRACTFOL_MAX_TOKENS=8192
